{
  "format": 2,
  "key": "bookshelf",
  "label": "Bookshelf",
  "tags": [
    "home",
    "interior",
    "office"
  ],
  "spanning": false,
  "params": [
    {
      "key": "width",
      "label": "Width",
      "type": "number",
      "default": 180,
      "min": 80,
      "max": 500,
      "step": 10
    },
    {
      "key": "height",
      "label": "Height",
      "type": "number",
      "default": 320,
      "min": 100,
      "max": 600,
      "step": 10
    },
    {
      "key": "shelves",
      "label": "Shelves",
      "type": "number",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1
    }
  ],
  "provenance": {
    "blender": "none (migrated from TypeScript)",
    "source": "sha1:0000000000000000000000000000000000000000",
    "baked": "2026-08-04"
  },
  "views": {
    "default": {
      "primitives": [
        {
          "k": "rect",
          "f": "woodDark",
          "x": "-width/2",
          "y": "-height",
          "w": "width",
          "h": "height"
        },
        {
          "k": "repeat",
          "n": "shelves",
          "dy": "height/shelves",
          "of": [
            {
              "k": "rect",
              "l": 0,
              "f": "wood",
              "x": "-width/2 + 6",
              "y": "-height + height/shelves - 10",
              "w": "width - 12",
              "h": 8
            },
            {
              "k": "repeat",
              "n": "ceil((width - 34)/16)",
              "dx": 16,
              "of": [
                {
                  "k": "rect",
                  "l": 0,
                  "f": "accent",
                  "show": "(i + j) % 4 == 0",
                  "x": "-width/2 + 14",
                  "y": "-height + height/shelves - 10 - height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)",
                  "w": "8 + ((i + j) % 3)*5",
                  "h": "height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)"
                },
                {
                  "k": "rect",
                  "l": 0,
                  "f": "fabric",
                  "show": "(i + j) % 4 == 1",
                  "x": "-width/2 + 14",
                  "y": "-height + height/shelves - 10 - height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)",
                  "w": "8 + ((i + j) % 3)*5",
                  "h": "height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)"
                },
                {
                  "k": "rect",
                  "l": 0,
                  "f": "foliage",
                  "show": "(i + j) % 4 == 2",
                  "x": "-width/2 + 14",
                  "y": "-height + height/shelves - 10 - height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)",
                  "w": "8 + ((i + j) % 3)*5",
                  "h": "height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)"
                },
                {
                  "k": "rect",
                  "l": 0,
                  "f": "clay",
                  "show": "(i + j) % 4 == 3",
                  "x": "-width/2 + 14",
                  "y": "-height + height/shelves - 10 - height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)",
                  "w": "8 + ((i + j) % 3)*5",
                  "h": "height/shelves*(0.45 + ((i*3 + j) % 4)*0.08)"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
