{
  "format": 2,
  "key": "counter",
  "label": "Kitchen counter",
  "tags": [
    "home",
    "interior"
  ],
  "spanning": false,
  "params": [
    {
      "key": "width",
      "label": "Width",
      "type": "number",
      "default": 320,
      "min": 100,
      "max": 700,
      "step": 10
    },
    {
      "key": "height",
      "label": "Height",
      "type": "number",
      "default": 130,
      "min": 60,
      "max": 220,
      "step": 5
    }
  ],
  "provenance": {
    "blender": "none (migrated from TypeScript)",
    "source": "sha1:0000000000000000000000000000000000000000",
    "baked": "2026-08-04"
  },
  "views": {
    "default": {
      "primitives": [
        {
          "k": "rect",
          "f": "surface",
          "x": "-width/2",
          "y": "-height",
          "w": "width",
          "h": "height"
        },
        {
          "k": "rect",
          "f": "surfaceDark",
          "x": "-width/2 - 6",
          "y": "-height",
          "w": "width + 12",
          "h": 16
        },
        {
          "k": "repeat",
          "n": "max(1, round(width/110)) - 1",
          "of": [
            {
              "k": "line",
              "f": "surfaceDark",
              "sw": 3,
              "x1": "-width/2 + (width/max(1, round(width/110)))*(i + 1)",
              "y1": "-height + 20",
              "x2": "-width/2 + (width/max(1, round(width/110)))*(i + 1)",
              "y2": -6
            }
          ]
        }
      ]
    }
  }
