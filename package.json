{
  "name": "animation-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Script to limited-animation scene. Free, local, deterministic.",
  "bin": {
    "anim": "./src/cli/index.ts"
  },
  "scripts": {
    "anim": "tsx src/cli/index.ts",
    "ui": "tsx src/cli/index.ts ui",
    "ui:build": "npm --prefix ui run build",
    "ui:dev": "npm --prefix ui run dev",
    "ui:install": "npm --prefix ui install",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
